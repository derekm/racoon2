#!/bin/sh

# DESTDIR (from "make install DESTDIR=...") stages the secret under the
# staging root; without it a staged install would back up and replace
# the live system's spmd.pwd.
D=${DESTDIR:-}

if [ -f "$D@prefix@/etc/racoon2/spmd.pwd" ]
then
	mv "$D@prefix@/etc/racoon2/spmd.pwd" "$D@prefix@/etc/racoon2/spmd.pwd.bak"
fi

if [ -x "$D@prefix@/sbin/pskgen" ]
then
	"$D@prefix@/sbin/pskgen" -r -o "$D@prefix@/etc/racoon2/spmd.pwd"
fi
