[Service]
# -P: native pcap (decrypted inbound IKE) for protocol forensics.
#   Installed (configured) only when --enable-pcap was given: a
#   non-pcap iked cannot parse -P and would crash-loop.  See the
#   PCAP conditional in samples/systemd/Makefile.am.
# -D 0x0001: DEBUG_FLAG_DEBUG (ikev2_config lease logs etc.)
ExecStart=
ExecStart=@racoon_sbindir@/iked -F -f @racoon_sysconfdir@/racoon2.conf -P /tmp/iked-native.pcap -D 0x0001
