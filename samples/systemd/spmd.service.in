[Unit]
Description=Racoon2 security policy manager (spmd)
Documentation=man:spmd(8)
After=network-online.target
Wants=network-online.target
Requires=spmd.socket
Before=iked.service kinkd.service

[Service]
Type=simple
ExecStart=@sbindir@/spmd -F
Restart=on-failure
RestartSec=2s
RuntimeDirectory=racoon2
RuntimeDirectoryMode=0700
WorkingDirectory=@sysconfdir@
StandardOutput=journal
StandardError=journal

# Sandbox. Root, CAP_NET_ADMIN: PF_KEY / NETLINK_XFRM.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_KEY
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
SystemCallArchitectures=native
ReadOnlyPaths=@sysconfdir@
ReadWritePaths=/run/racoon2 /var/run/racoon2

[Install]
WantedBy=multi-user.target
Also=spmd.socket
