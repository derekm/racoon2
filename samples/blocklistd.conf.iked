# blocklistd fragment for iked (UDP/500 + UDP/4500).
# Install as /etc/blocklistd.conf.d/iked.conf (or merge into
# /etc/blocklistd.conf); see derekm/blocklist linux-port LINUX.md.
#
# Columns: location type family owner name nfail duration
#  - family "udp" matches IPv4 sockets only and "udp6" IPv6 only, so
#    both are listed.  Numeric ports avoid /etc/services differences
#    (Debian/Ubuntu call 4500 "ipsec-nat-t", not "isakmp-natt").
#  - blocklistd counts an AUTH_FAIL as 2, so nfail 8 == 4 reports.
#    iked rate-limits AUTH_FAIL to one report per source per 10s, so
#    a scanner is banned after ~30s of sustained garbage.
#
# iked reports (blocklist_sa_r with the receiving UDP socket):
#   shortpacket / malformed_len / zero-cookie / AUTH_FAILED -> AUTH_FAIL
#   AUTH_OK (IKEv2 responder auth success)                  -> AUTH_OK
#                                                     (resets the count)

[local]
500     dgram   udp     *   *   8   1h
4500    dgram   udp     *   *   8   1h
500     dgram   udp6    *   *   8   1h
4500    dgram   udp6    *   *   8   1h

[remote]
# Allowlist: nfail "*" means never block.  List management / monitoring
# hosts and known site-to-site peers.  Placeholders -- replace:
#192.0.2.10/32          *       *       *   =   *   *
#[2001:db8::10]/128     *       *       *   =   *   *
